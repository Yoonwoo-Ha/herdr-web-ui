{
  "name": "herdr-br",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser version of the herdr terminal - live herdr workspaces, panes and agents in a web UI",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "bun run server/index.ts",
    "start": "bun run build && bun run server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "generate:types": "bun run scripts/generate-protocol-types.ts"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/bun": "^1.1.14",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "playwright-core": "^1.49.1"
  }
}
